/**
 * ESP32-WROOM-32E 麦克纳姆轮小车 电机驱动板 通信程序
 * 
 * 功能说明：
 *   ESP32 作为主控板，通过 I2C 总线向 Hiwonder 四路编码电机驱动模块（从机地址 0x34）
 *   发送指令，控制4个 JGB37-520R90-12 编码电机（11线，减速比1:90）执行各种运动模式。
 *   驱动模块板载 MCU 和 SA8339 驱动芯片，负责 PID 闭环控制，
 *   主控只需通过 I2C 写入目标转速即可。
 * 
 * 硬件接线（独立供电方式）：
 *   ESP32 GPIO18 (SDA) <---> 驱动板 IIC接口 SDA
 *   ESP32 GPIO19 (SCL) <---> 驱动板 IIC接口 SCL
 *   ESP32 GND          <---> 驱动板 IIC接口 GND  （必须共地！）
 *   ESP32 由独立电源供电，驱动板由电池通过电源接口或3Pin接口供电
 * 
 *   注意：驱动板 IIC 接口的 5V 引脚只支持电压输入，不能输出，
 *         不要指望通过它给主控供电。
 *   注意：V1.2 版本驱动板的 SDA/SCL 丝印印反了，接线时需对调。
 *         V1.3 及之后版本已修正。
 * 
 * 底盘电机位置（俯视）：
 *       M1(左前)    M3(右前)
 *       M2(左后)    M4(右后)
 * 
 * 开发环境：PlatformIO + Arduino 框架，板子选 esp32dev
 */

#include <Arduino.h>   // PlatformIO 下必须手动包含，提供 Serial、delay 等基础函数
#include <Wire.h>      // I2C 通信库
#include <WiFi.h>
#include <micro_ros_platformio.h>
#include <rcl/rcl.h>
#include <rclc/rclc.h>
#include <rclc/executor.h>

// ============ ESP32 I2C 引脚配置 ============
// ESP32 的 I2C 引脚可以任意映射到空闲 GPIO
// 这里选用 GPIO18 作为 SDA，GPIO19 作为 SCL
#define I2C_SDA_PIN  18
#define I2C_SCL_PIN  19
// ============================================

// 电机驱动板的 I2C 从机地址（硬件固定，保持默认）
#define I2C_ADDR        0x34

// ============ 驱动板寄存器地址定义 ============
// 这些是寄存器的"地址"，不是要写入的数据值
// 通过向对应地址写入数据来控制驱动板的行为

#define ADC_BAT_ADDR                  0   // 寄存器地址 0x00：读取电池 ADC 采样值
#define MOTOR_TYPE_ADDR               20  // 寄存器地址 0x14：设置编码电机类型
                                          // 向此地址写入 0/1/2/3 来选择电机类型
#define MOTOR_ENCODER_POLARITY_ADDR   21  // 寄存器地址 0x15：设置编码器方向极性
                                          // 必须设为 0，否则电机会一直正转无法控制方向
                                          // 如果电机不受控（全速或停止），试着改成 1
#define MOTOR_FIXED_PWM_ADDR      31      // 寄存器地址 0x1F：固定 PWM 开环控制，范围 -100~100
#define MOTOR_FIXED_SPEED_ADDR    51      // 寄存器地址 0x33：固定转速闭环控制（本程序使用）
                                          // 单位：脉冲数/10ms，建议范围 ±50
#define MOTOR_ENCODER_TOTAL_ADDR  60      // 寄存器地址 0x3C：读取4个电机各自的累计脉冲总数
                                          // 向此地址写入 16 字节 0x00 可重置脉冲计数
                                          // 可用于里程计：距离 = (脉冲数/每圈脉冲数) × π × 轮径

// ============ 电机类型常量（写入寄存器地址 20 的值）============
// 不同类型对应驱动板固件内置的不同编码器参数
#define MOTOR_TYPE_WITHOUT_ENCODER    0   // 无编码器电机（44线，减速比 1:90）
#define MOTOR_TYPE_TT                 1   // TT 编码电机（3线，减速比 1:84）
#define MOTOR_TYPE_N20                2   // N20 编码电机（13线，减速比 1:20，适配 JGA27-310R20）
#define MOTOR_TYPE_JGB                3   // JGB 编码电机（11线，减速比 1:90，适配 JGB37-520R90-12）
                                          // ★ 本底盘使用的就是这款电机
                                          // 每圈总脉冲数 = 11(编码器线数) × 90(减速比) = 990

// 通用数据缓冲区（预留，供读取数据时使用）
uint8_t data[20];

// ============ I2C 底层通信函数 ============

/**
 * 向驱动板发送单个字节（通常用于指定要读取的寄存器地址）
 * @param val 要发送的字节
 * @return 发送成功返回 true，失败返回 false
 */
bool WireWriteByte(uint8_t val)
{
    Wire.beginTransmission(I2C_ADDR);  // 开始向从机地址 0x34 发起通信
    Wire.write(val);                   // 写入一个字节
    if (Wire.endTransmission() != 0) { // 结束传输，返回 0 表示收到 ACK（成功）
        return false;
    }
    return true;
}

/**
 * 向驱动板的指定寄存器写入一组数据
 * I2C 写入协议：[从机地址] [寄存器地址] [数据0] [数据1] ... [数据N]
 * @param reg 目标寄存器地址
 * @param val 数据数组指针
 * @param len 数据长度（字节数）
 * @return 写入成功返回 true，失败返回 false
 */
bool WireWriteDataArray(uint8_t reg, uint8_t *val, unsigned int len)
{
    unsigned int i;
    Wire.beginTransmission(I2C_ADDR);  // 开始通信
    Wire.write(reg);                   // 第一个字节：寄存器地址
    for (i = 0; i < len; i++) {
        Wire.write(val[i]);            // 后续字节：逐个写入数据
    }
    if (Wire.endTransmission() != 0) { // 提交并检查是否成功
        return false;
    }
    return true;
}

/**
 * 从驱动板的指定寄存器读取单个字节
 * I2C 读取协议：先写寄存器地址，再读数据
 * @param reg 目标寄存器地址
 * @param val 读取结果存放变量（引用）
 * @return 读取成功返回 true，失败返回 false
 */
bool WireReadDataByte(uint8_t reg, uint8_t &val)
{
    if (!WireWriteByte(reg)) {            // 先发送寄存器地址（告诉从机要读哪里）
        return false;
    }
    Wire.requestFrom(I2C_ADDR, 1);        // 向从机请求 1 个字节
    while (Wire.available()) {
        val = Wire.read();                // 读取返回的数据
    }
    return true;
}

/**
 * 从驱动板的指定寄存器读取多个字节
 * @param reg 起始寄存器地址
 * @param val 数据存放数组
 * @param len 要读取的字节数
 * @return 实际读取的字节数，失败返回 -1
 */
int WireReadDataArray(uint8_t reg, uint8_t *val, unsigned int len)
{
    unsigned char i = 0;
    if (!WireWriteByte(reg)) {                // 先发送起始寄存器地址
        return -1;
    }
    Wire.requestFrom(I2C_ADDR, (int)len);     // 请求 len 个字节（ESP32 Wire 库需要 int 类型参数）
    while (Wire.available()) {
        if (i >= len) {                       // 防止数组越界
            return -1;
        }
        val[i] = Wire.read();                // 逐字节读取
        i++;
    }
    return i;  // 返回实际读到的字节数
}


// ============ 电机配置参数 ============
uint8_t MotorType = MOTOR_TYPE_JGB;     // 电机类型值 = 3（JGB37-520R90-12），写入寄存器地址 20
uint8_t MotorEncoderPolarity = 0;       // 编码器极性 = 0（默认），写入寄存器地址 21
                                        // 文档要求必须设为 0，否则无法控制转向

// 函数前置声明（PlatformIO 的 .cpp 文件不会像 Arduino IDE 那样自动生成函数原型）
void Running(int8_t running_mode[4]);

/**
 * 初始化函数，上电执行一次
 */
void setup()
{
    Serial.begin(115200);  // 初始化串口，115200 波特率，用于调试输出
    Serial.println("ESP32 Motor Driver Demo Starting...");

    Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);  // 初始化 I2C，指定 ESP32 的 SDA/SCL 引脚
    delay(200);                             // 等待驱动板上电稳定

    // 向寄存器地址 20 写入电机类型值 3（JGB）
    WireWriteDataArray(MOTOR_TYPE_ADDR, &MotorType, 1);
    delay(5);
    // 向寄存器地址 21 写入编码器极性值 0
    WireWriteDataArray(MOTOR_ENCODER_POLARITY_ADDR, &MotorEncoderPolarity, 1);
    delay(2000);  // 等待驱动板完成内部初始化

    Serial.println("Motor driver initialized.");
}

// ============ 运动模式定义 ============
// 每个数组4个元素，依次对应 [M1(左前), M2(左后), M3(右前), M4(右后)] 的目标转速
// 正值/负值代表电机的电气转向（不直接等于轮子前进/后退，取决于电机安装方向）
// 由于左右两侧及前后电机安装朝向和麦轮滚子方向不同，
// 实现同一运动时各电机的正负号需要分别设定
// 建议速度范围 [-50, 50]

int8_t car_forward[4]  = { 30, -30, -30,  30};   // 前进：对角电机同号（M1M4正，M2M3负）
int8_t car_back[4]     = {-30,  30,  30, -30};   // 后退：前进的完全取反

int8_t car_left_transform[4]  = {-30, -30, -30, -30};  // 左平移：四个电机全负
int8_t car_right_transform[4] = { 30,  30,  30,  30};  // 右平移：四个电机全正

int8_t car_turn_left[4]  = { 30, -30, -10,  10};  // 前进中左转弯（左侧快，右侧慢）
int8_t car_turn_right[4] = { 10, -10, -30,  30};  // 前进中右转弯（左侧慢，右侧快）

int8_t car_turn_left_back[4]  = {-30,  30,  10, -10};  // 后退中左转弯
int8_t car_turn_right_back[4] = {-10,  10,  30, -30};  // 后退中右转弯

int8_t car_turn_left_orin[4] = {-30,  30, -30,  30};  // 原地左转：左侧轮后退，右侧轮前进
int8_t car_turn_right_orin[4]  = { 30, -30,  30, -30};  // 原地右转：左侧轮前进，右侧轮后退

int8_t car_Ob_translation_left_up[4]    = {  0, -30, -30,   0};  // 左前方 45° 平移（M1M4停，M2M3动）
int8_t car_Ob_translation_right_up[4]   = { 30,   0,   0,  30};  // 右前方 45° 平移（M1M4动，M2M3停）
int8_t car_Ob_translation_left_back[4]  = {-30,   0,   0, -30};  // 左后方 45° 平移
int8_t car_Ob_translation_right_back[4] = {  0,  30,  30,   0};  // 右后方 45° 平移

int8_t car_drift_left[4]  = {-30, 0, -30, 0};   // 左漂移（M1M3动，M2M4停）
int8_t car_drift_right[4] = { 30, 0,  30, 0};   // 右漂移（M1M3动，M2M4停）

int8_t car_stop[4] = {0, 0, 0, 0};              // 停止所有电机

// 单电机调试用：分别只让一个电机转，用于确认各电机接线和转向是否正确
int8_t m1_work[4] = {30, 0, 0, 0};   // 只有 M1(左前) 正转
int8_t m2_work[4] = {0, 30, 0, 0};   // 只有 M2(左后) 正转
int8_t m3_work[4] = {0, 0, 30, 0};   // 只有 M3(右前) 正转
int8_t m4_work[4] = {0, 0, 0, 30};   // 只有 M4(右后) 正转

/**
 * 执行一个运动动作
 * 向驱动板寄存器地址 51 写入4个电机的目标转速，运行一段时间后自动停止
 * @param running_mode 包含4个电机转速的 int8_t 数组 [M1, M2, M3, M4]
 */
void Running(int8_t running_mode[4])
{
    // 将 int8_t* 强转为 uint8_t* 发送（I2C 传输的是原始字节，驱动板固件会按有符号数解析）
    WireWriteDataArray(MOTOR_FIXED_SPEED_ADDR, (uint8_t*)running_mode, 4);
    delay(5000);  // 运行 5 秒
    // 向同一寄存器写入全零，停止所有电机
    WireWriteDataArray(MOTOR_FIXED_SPEED_ADDR, (uint8_t*)car_stop, 4);
    delay(1000);  // 停顿 1 秒后执行下一个动作
}

/**
 * 主循环 - 依次演示各种运动模式，演示完毕后停止
 */
void loop()
{
    Serial.println("前进");
    Running(car_forward);

    Serial.println("后退");
    Running(car_back);

    Serial.println("左平移");
    Running(car_left_transform);

    Serial.println("右平移");
    Running(car_right_transform);

    Serial.println("原地左转");
    Running(car_turn_left_orin);

    Serial.println("原地右转");
    Running(car_turn_right_orin);

    Serial.println("左前平移");
    Running(car_Ob_translation_left_up);

    Serial.println("右后平移");
    Running(car_Ob_translation_right_back);

    Serial.println("左漂移");
    Running(car_drift_left);

    Serial.println("右漂移");
    Running(car_drift_right);

    // 单电机调试（取消注释可逐个测试各电机）
    // Running(m1_work);
    // Running(m2_work);
    // Running(m3_work);
    // Running(m4_work);

    Serial.println("演示完毕，停止。");
    while (1) { delay(1000); }  // 演示结束，死循环停在这里，不再重复
}