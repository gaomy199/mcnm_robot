<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 引入质量和惯性参数 -->
    <xacro:include filename="$(find mcnm_robot_description)/urdf/mcnm_robot/common_inertia.xacro" />

    <xacro:macro name="laser_xacro" params="xyz">
        <!-- 声明 激光雷达laser 模块 -->
        <link name="laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.025" length="0.019" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8" />
                </material>
            </visual>
            <!-- 碰撞属性 -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.025" length="0.019" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.6" />
                </material>
            </collision>
            <!-- 惯性和质量属性 -->
            <xacro:cylinder_inertia m = "0.05" r = "0.025" h = "0.019" />
        </link>
        <!-- 声明 laser支撑杆 模块 -->
        <link name="laser_support_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.028" length="0.03" />
                </geometry>
                <material name="cyan">
                    <color rgba="0.2 0.8 0.8 0.7" />
                </material>
            </visual>
            <!-- 碰撞属性 -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.028" length="0.03" />
                </geometry>
                <material name="cyan">
                    <color rgba="0.2 0.8 0.8 0.3" />
                </material>
            </collision>
            <!-- 惯性和质量属性 -->
            <xacro:cylinder_inertia m = "0.05" r = "0.028" h = "0.03" />
        </link>
        <!-- 声明 laser支撑杆 和 激光雷达 的关节 -->
        <joint name="laser_joint" type="fixed">
            <parent link="laser_support_link" />
            <child link="laser_link" />
            <origin xyz="0 0 0.0245" rpy="0 0 0" />
        </joint>
        <joint name="laser_support_joint" type="fixed">
            <parent link="base_link" />
            <child link="laser_support_link" />
            <origin xyz="${xyz}" rpy="0 0 3.14159" />
            <!-- laser支撑杆坐标默认为0.13 0 0.055 -->
        </joint>

    </xacro:macro>
</robot>